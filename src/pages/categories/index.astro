---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const products = await getCollection('products');
const categories = [...new Set(products.map(p => p.data.category))];
---
<BaseLayout title="全部分类">
  <h1 style="padding: 16px;">全部分类</h1>
  <div class="category-grid">
    {categories.map(cat => (
      <a href={`/categories/${encodeURIComponent(cat)}/`} class="category-item"><div class="category-icon">📦</div><span>{cat}</span></a>
    ))}
  </div>
</BaseLayout>
