---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="个人中心">
  <div style="padding: 16px; text-align: center; margin-top: 40px;">
    <div style="width: 80px; height: 80px; background: #eee; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 2rem;">👤</div>
    <h2 style="margin-top: 16px;">您好，游客</h2>
    <p style="color: #888; margin-top: 8px;">欢迎来到我的产品展示站</p>
    <div style="margin-top: 30px; background: #fff; border-radius: 12px; padding: 16px; text-align: left; box-shadow: 0 2px 8px rgba(0,0,0,0.04);"><p>📞 联系方式：请修改此页面</p><p style="margin-top: 10px;">📍 关于我们：这里是个人中心页面</p></div>
  </div>
</BaseLayout>
