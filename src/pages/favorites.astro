---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="我的收藏">
  <h1 style="padding: 16px;">我的收藏</h1>
  <div id="favoritesList" class="product-grid"></div>
  <script>
    const list = document.getElementById('favoritesList');
    const favs = JSON.parse(localStorage.getItem('favorites') || '[]');
    if (favs.length === 0) {
      list.innerHTML = '<p style="padding:16px;color:#888;">暂无收藏产品</p>';
    } else {
      list.innerHTML = favs.map(p => `
        <a href="/products/${p.slug}/" class="product-card">
          <div class="product-image"><img src="${p.image || '/images/placeholder.jpg'}" /></div>
          <div class="product-info"><h3 style="font-size:0.9rem;">${p.title}</h3></div>
        </a>
      `).join('');
    }
  </script>
</BaseLayout>
