---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const products = await getCollection('products');
---
<BaseLayout title="搜索">
  <div style="padding: 16px;">
    <input type="text" id="searchInput" placeholder="搜索产品..." style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #ddd; font-size: 1rem; margin-bottom: 16px;" />
    <div id="searchResults" class="product-grid" style="padding: 0;">
      {products.map(product => (
        <a href={`/products/${product.slug}/`} class="product-card" data-title={product.data.title}>
          <div class="product-image"><img src={product.data.images?.[0] || '/images/placeholder.jpg'} alt={product.data.title} /></div>
          <div class="product-info"><h3>{product.data.title}</h3><p class="product-price">¥{product.data.price}</p></div>
        </a>
      ))}
    </div>
  </div>
  <script>
    const input = document.getElementById('searchInput');
    const cards = Array.from(document.getElementById('searchResults').getElementsByClassName('product-card'));
    input.addEventListener('input', (e) => {
      const val = e.target.value.toLowerCase();
      cards.forEach(card => {
        card.style.display = card.getAttribute('data-title').toLowerCase().includes(val) ? 'flex' : 'none';
      });
    });
  </script>
</BaseLayout>
