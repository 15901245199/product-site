---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 获取轮播图、产品、自定义链接
const banners = (await getCollection('banners')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const products = await getCollection('products');
const links = (await getCollection('links')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// 提取所有分类（去重）
const categories = [...new Set(products.map(p => p.data.category))];
---
<BaseLayout title="首页">
  <!-- 顶部轮播图 -->
  {banners.length > 0 && (
    <section class="carousel">
      {banners.map(banner => (
        <a href={banner.data.link || '#'} class="carousel-item">
          <img src={banner.data.image} alt={banner.data.title} />
        </a>
      ))}
    </section>
  )}

  <!-- 中间大分类 -->
  <section>
    <h2 style="padding: 0 16px; font-size: 1.1rem; margin-top: 10px;">产品分类</h2>
    <div class="category-grid">
      {categories.slice(0, 8).map(cat => (
        <a href={`/categories/${encodeURIComponent(cat)}/`} class="category-item">
          <div class="category-icon">📦</div>
          <span>{cat}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 自定义跳转链接 -->
  {links.length > 0 && (
    <section style="padding: 16px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">推荐服务</h2>
      <div class="link-list" style="padding: 0;">
        {links.map(link => (
          <a href={link.data.url} class="link-item" target="_blank">
            <span>{link.data.icon} {link.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 推荐产品（可选） -->
  <section style="padding: 16px;">
    <h2 style="font-size: 1.1rem; margin-bottom: 12px;">热门产品</h2>
    <div class="product-grid" style="padding: 0;">
      {products.slice(0, 4).map(product => (
        <a href={`/products/${product.slug}/`} class="product-card">
          <div class="product-image">
            <img src={product.data.images?.[0] || '/images/placeholder.jpg'} alt={product.data.title} />
          </div>
          <div class="product-info">
            <h3 style="font-size: 0.9rem;">{product.data.title}</h3>
            <p class="product-price" style="font-size: 0.9rem;">¥{product.data.price}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
