---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '产品展示' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <div class="app-container">
    <main class="main-content">
      <slot />
    </main>

    <!-- 固定在底部的状态栏 -->
    <nav class="bottom-nav">
      <a href="/" class:list={["nav-item", { active: currentPath === '/' }]}>
        <span class="nav-icon">🏠</span>
        <span class="nav-text">首页</span>
      </a>
      <a href="/categories/" class:list={["nav-item", { active: currentPath.startsWith('/categories') }]}>
        <span class="nav-icon">🗂️</span>
        <span class="nav-text">分类</span>
      </a>
      <a href="/search/" class:list={["nav-item", { active: currentPath === '/search/' }]}>
        <span class="nav-icon">🔍</span>
        <span class="nav-text">搜索</span>
      </a>
      <a href="/favorites/" class:list={["nav-item", { active: currentPath === '/favorites/' }]}>
        <span class="nav-icon">❤️</span>
        <span class="nav-text">收藏</span>
      </a>
      <a href="/profile/" class:list={["nav-item", { active: currentPath === '/profile/' }]}>
        <span class="nav-icon">👤</span>
        <span class="nav-text">我的</span>
      </a>
    </nav>
  </div>
</body>
</html>
